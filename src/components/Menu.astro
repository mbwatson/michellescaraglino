---
import Icon from './Icon.astro'
---

<button class="toggler" aria-label="Menu" aria-expanded="false" aria-controls="drawer">
  <Icon name="hamburger" class="open-icon" size={30} />
  <Icon name="close" class="close-icon" fill="#ddc8ce" size={36} />
</button>
<div class="overlay"></div>
<nav class="drawer" id="drawer">
  <div class="navigation">
    <a class="nav-item" href="/hair">Hair</a>
    <a class="nav-item" href="/styling">Styling</a>
    <a class="nav-item" href="/contact">Contact</a>
    <a class="nav-item" href="https://www.instagram.com/michellescaraglinohair" target="_blank" rel="noopener noreferrer">Instagram</a>
  </div>
</nav>

<script>
  const toggler = document.querySelector<HTMLButtonElement>('.toggler')!
  const overlay = document.querySelector<HTMLElement>('.overlay')!
  const drawer = document.querySelector<HTMLElement>('.drawer')!

  const setOpen = (open: boolean) => {
    toggler.setAttribute('aria-expanded', String(open))
    overlay.classList.toggle('active', open)
    drawer.classList.toggle('open', open)
    document.body.style.overflow = open ? 'hidden' : 'auto'
  }
  const isOpen = () => drawer.classList.contains('open')

  toggler.addEventListener('click', () => setOpen(!isOpen()))
  overlay.addEventListener('click', () => setOpen(false))
  drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)))
  document.body.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      event.preventDefault()
      setOpen(false)
    }
  })
</script>

<style>
  .toggler {
    position: absolute;
    top: 60%;
    transform: translateY(-50%);
    right: 0;
    width: 4rem;
    cursor: pointer;
    padding: var(--spacing-medium) 0 0 0;
    z-index: 3;
    background-color: transparent;
    outline: none;
    border: 0;
  }
  .toggler :global(svg) {
    transition: fill 250ms;
  }
  .toggler:hover :global(svg) {
    fill: var(--color-primary-light);
  }
  .toggler :global(.close-icon),
  .toggler[aria-expanded='true'] :global(.open-icon) {
    display: none;
  }
  .toggler[aria-expanded='true'] :global(.close-icon) {
    display: inline;
  }

  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #ffffff;
    opacity: 0;
    transition: opacity 250ms;
    pointer-events: none;
    z-index: -1;
  }
  .overlay.active {
    z-index: 2;
    opacity: 0.5;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    left: 100%;
    height: 100vh;
    width: 450px;
    max-width: 90%;
    z-index: 2;
    transition: transform 100ms ease-out;
  }
  .drawer.open {
    transform: translateX(-100%);
  }

  .navigation {
    background-color: var(--color-primary);
    width: 100%;
    height: 100vh;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding-top: calc(3 * var(--spacing-extra-large));
    margin: 0;
  }

  .nav-item {
    color: var(--color-secondary);
    padding: var(--spacing-medium) 2rem;
    text-transform: uppercase;
    font-size: 150%;
    font-family: var(--font-heading);
    text-decoration: none;
  }
</style>
