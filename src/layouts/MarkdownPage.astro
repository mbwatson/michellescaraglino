---
// A page that shows one entry of the pages collection in a centered column
import { getEntry, render } from 'astro:content'
import Layout from './Layout.astro'

interface Props {
  entry: string
  title: string
  description: string
}

const { entry, title, description } = Astro.props
const { Content } = await render((await getEntry('pages', entry))!)
---

<Layout title={title} description={description}>
  <div class="grid">
    <div class="row">
      <div class="col">
        <div class="content"><Content /></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .grid {
    position: relative;
    padding: 0 15px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -32px;
  }
  .col {
    position: relative;
    flex: 0 0 100%;
    max-width: 100%;
    min-height: 1px;
    padding: 0 32px;
  }
  @media (min-width: 992px) {
    .col {
      flex-basis: 66.6667%;
      max-width: 66.6667%;
      left: 16.6667%;
    }
  }
</style>
