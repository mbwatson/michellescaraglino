---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import hairImage from '../images/hair-link-hover.jpg'
import stylingImage from '../images/styling-link-hover.jpg'
---

<Layout title="Home">
  <h1 class="title" hidden>Home</h1>

  <div class="grid">
    <div class="row">
      <div class="col col-hair">
        <a href="/hair" class="image-link hair-link">
          <div class="image-wrapper">
            <Image class="image" src={hairImage} alt="" loading="eager" widths={[400, 800, hairImage.width]} sizes="(max-width: 992px) 100vw, 60vw" />
            <div class="overlay"></div>
          </div>
          <h1 class="title link-text">HAIR</h1>
        </a>
      </div>
      <div class="col col-styling">
        <a href="/styling" class="image-link styling-link">
          <div class="image-wrapper">
            <Image class="image" src={stylingImage} alt="" loading="eager" widths={[400, 800, stylingImage.width]} sizes="(max-width: 992px) 100vw, 40vw" />
            <div class="overlay"></div>
          </div>
          <h1 class="title link-text">Styling</h1>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* narrow ("compact") layout first; the wide layout starts above 992px */
  .grid {
    position: relative;
    padding: 0 15px;
    margin-top: 2rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .col {
    position: relative;
    flex: 0 0 100%;
    max-width: 100%;
    min-height: 1px;
  }
  @media (min-width: 992px) {
    .col-hair {
      flex-basis: 58.3333%;
      max-width: 58.3333%;
    }
    .col-styling {
      flex-basis: 41.6667%;
      max-width: 41.6667%;
    }
  }

  .image-link {
    text-decoration: none;
  }
  .image-wrapper {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    object-fit: cover;
    transition: filter 250ms;
    filter: saturate(0.1) brightness(1.1);
  }
  .overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #9a4457;
    transition: opacity 250ms;
    opacity: 0.35;
  }
  .image-wrapper:hover .image {
    filter: saturate(1) brightness(1);
  }
  .image-wrapper:hover .overlay {
    opacity: 0;
  }

  .link-text {
    position: absolute;
    font-family: var(--font-heading);
    font-size: 175%;
    -webkit-text-stroke: 1px var(--color-black);
    -webkit-text-fill-color: var(--color-white);
  }
  .image-link:hover .link-text {
    -webkit-text-fill-color: var(--color-black);
  }

  .hair-link .image {
    min-height: 800px;
  }
  .hair-link .link-text {
    left: calc(100% - 10rem);
    top: -3rem;
  }

  .styling-link {
    display: block;
    margin-top: 5rem;
  }
  .styling-link .image {
    min-height: 500px;
  }
  .styling-link .link-text {
    left: 50%;
    top: 2rem;
    transform: translateX(-50%);
  }

  @media (min-width: 993px) {
    .grid {
      transform: translateX(-3rem);
      margin-top: -7rem;
    }
    .row {
      margin: 0 -60px;
    }
    .col {
      padding: 0 60px;
    }
    .link-text {
      font-size: 200%;
    }
    .hair-link .link-text {
      left: calc(100% - 2rem);
      top: 5rem;
    }
    .styling-link {
      margin-top: 10rem;
    }
    .styling-link .link-text {
      top: 7rem;
    }
  }
</style>
