---
import { Image } from 'astro:assets'
import { getCollection, getEntry, render } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Spacer from '../components/Spacer.astro'
import image from '../images/michelle-styling.jpg'

const { Content } = await render((await getEntry('pages', 'styling'))!)
const testimonials = await Promise.all(
  (await getCollection('testimonials'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ quote: entry.data.quote, Attribution: (await render(entry)).Content })),
)
---

<Layout
  title="Styling"
  keywords={['personal styling', 'closet edit']}
  stars={[
    { x: 84, y: 8, size: 150 },
    { x: 72, y: 30, size: 380, phone: true },
    { x: 90, y: 50, size: 110, thin: false },
    { x: 3, y: 44, size: 50 },
    { x: 62, y: 66, size: 60 },
    { x: 80, y: 82, size: 260 },
    { x: 3, y: 75, size: 150, phone: true },
  ]}
>
  <div class="grid">
    <div class="row">
      <div class="col col-content">
        <div class="narrow-only"><br /><br /></div>
        <div class="content"><Content /></div>

        <Spacer />

        <section>
          {testimonials.map(({ quote, Attribution }) => (
            <Fragment>
              <blockquote>{quote}</blockquote>
              <div class="attribution"><Attribution /></div>
              <br />
            </Fragment>
          ))}
        </section>
      </div>
      <div class="col col-image">
        <div class="wide-only"><br /><br /><br /><br /><br /><br /></div>
        <Image class="image" src={image} alt="Michelle Scaraglino" widths={[200, 400, image.width]} sizes="(max-width: 400px) 100vw, 400px" />
      </div>
    </div>
  </div>
</Layout>

<style>
  .grid {
    position: relative;
    padding: 0 15px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -32px;
  }
  .col {
    position: relative;
    flex: 0 0 100%;
    max-width: 100%;
    min-height: 1px;
    padding: 0 32px;
  }
  @media (min-width: 992px) {
    .col {
      left: 8.3333%;
    }
    .col-content {
      flex-basis: 50%;
      max-width: 50%;
    }
    .col-image {
      flex-basis: 41.6667%;
      max-width: 41.6667%;
    }
  }
  .image {
    display: block;
    width: 100%;
    height: 526px;
    margin: 0;
    object-fit: cover;
  }
  blockquote {
    margin: 0.5rem 0;
    font-style: italic;
  }
  .attribution {
    text-align: right;
    padding-left: 10%;
  }
</style>
